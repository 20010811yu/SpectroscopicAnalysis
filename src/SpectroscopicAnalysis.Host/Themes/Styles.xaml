<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 通用控件样式（界面规范第 5/6 节）：卡片/状态点/徽章/导航项/按钮；颜色一律经 Brush.* 资源 -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brushes.xaml" />
        <ResourceDictionary Source="Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 卡片：圆角 8 / 边框 / 轻阴影 -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08" Direction="270" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 状态点（图标白名单：固定 8px） -->
    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Fill" Value="{DynamicResource Brush.Status.Idle}" />
        <Setter Property="Stroke" Value="Transparent" />
    </Style>

    <!-- 状态徽章：颜色+文字双表达（正文文字由内容自带，底色按语义选变体） -->
    <Style x:Key="Badge.Base" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="Background" Value="{DynamicResource Brush.Badge.Idle.Bg}" />
    </Style>

    <!-- 导航项按钮（侧栏）：选中态主色 -->
    <Style x:Key="NavItem" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg.Page}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 导航项选中态（经 Tag 传 key 的替代方案：代码极简，此处用独立样式） -->
    <Style x:Key="NavItem.Active" TargetType="Button" BasedOn="{StaticResource NavItem}">
        <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 顶栏模式按钮 -->
    <Style x:Key="ModeBtn" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- 归零 HandyControl 隐式样式的最小尺寸，避免顶栏右侧组溢出窗口 -->
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 急停圆钮（图标白名单：固定 48px，高对比） -->
    <Style x:Key="EStopBtn" TargetType="Button">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Emergency}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Brush.Status.Emergency}" BorderThickness="3"
                            CornerRadius="24">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Status.Emergency}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 表格标题行文本 -->
    <Style x:Key="Table.Header" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <!-- ============ 通用按钮样式（统一系统风格） ============ -->
    <!-- 主色按钮：可点击动作按钮统一蓝底白字；hover 深蓝、禁用灰底 -->
    <Style x:Key="PrimaryBtn" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="4" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Primary.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Bg.Disabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 危险按钮：删除类，红描边透明底；hover 淡红底 -->
    <Style x:Key="DangerBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="4" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Badge.Failed.Bg}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 次级按钮：取消/关闭类，白底描边；hover 描边变主色 -->
    <Style x:Key="SecondaryBtn" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="4" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource Brush.Bg.Disabled}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ============ DataGrid 共享样式（样品台账 / 生产样品等表格共用） ============ -->
    <!-- 表格行：只读展示，选中不加任何高亮，外观与普通行一致；行高取自然高度并保证舒适的最小行高 -->
    <Style x:Key="GridRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="MinHeight" Value="40" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- 表格单元格：选中保持正文前景与透明底；内容垂直居中、水平靠左（界面规范 5.2） -->
    <Style x:Key="GridCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="8,6" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- 文本单元格内容：垂直居中、水平靠左（界面规范 5.2） -->
    <Style x:Key="GridCellText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- 列标题：靠左与数据列对齐；无边框无阴影（界面规范 5.2）。
         重写 Template：标题文字随列宽自动省略号截断，防止列变窄时溢出压到相邻标题；
         右侧保留 PART_RightHeaderGripper 抓取区，鼠标拖拽改列宽功能不变。 -->
    <Style x:Key="GridColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="0,0,12,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- 标题文字：超出列宽时省略号截断，不溢出 -->
                            <TextBlock Grid.Column="0" Text="{TemplateBinding Content}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       FontSize="{TemplateBinding FontSize}" />
                            <!-- 右缘拖拽调列宽抓取区（命名约定 PART_ 使默认拖拽逻辑生效） -->
                            <Thumb x:Name="PART_RightHeaderGripper" Grid.Column="1" Width="8"
                                   HorizontalAlignment="Right" VerticalAlignment="Stretch" Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 日期选择器（蓝色主题）：边框与日历小图标统一引用 Brush.Primary，弹层日历边框同为蓝色 -->
    <Style x:Key="DatePickerStyle" TargetType="DatePicker">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid x:Name="PART_Root" Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- 边框（蓝色） -->
                        <Border Grid.ColumnSpan="2"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" />
                        <!-- 文本区（命名约定 PART_TextBox 使日期输入生效） -->
                        <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                           Background="Transparent" BorderThickness="0"
                                           Padding="{TemplateBinding Padding}"
                                           VerticalContentAlignment="Center"
                                           Foreground="{DynamicResource Brush.Text.Primary}" />
                        <!-- 日历小图标（蓝色，命名约定 PART_Button 使弹层开关生效） -->
                        <Button x:Name="PART_Button" Grid.Column="1" Margin="0,0,5,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <!-- 日历本体（尾部横线挖空形成页眉分界） -->
                                        <Path Fill="{DynamicResource Brush.Primary}"
                                              Data="M5,4 L19,4 C19.6,4 20,4.4 20,5 L20,20 C20,20.6 19.6,21 19,21 L5,21 C4.4,21 4,20.6 4,20 L4,5 C4,4.4 4.4,4 5,4 Z M4,8.5 L20,8.5 L20,10 L4,10 Z" />
                                        <!-- 顶部两个日历别针 -->
                                        <Path Fill="{DynamicResource Brush.Primary}"
                                              Data="M7.5,2 L9,2 L9,4.5 L7.5,4.5 Z M15,2 L16.5,2 L16.5,4.5 L15,4.5 Z" />
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- 日历弹层（蓝色边框；命名约定 PART_Popup / PART_Calendar） -->
                        <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" Placement="Bottom"
                               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Slide">
                            <Calendar x:Name="PART_Calendar"
                                      BorderBrush="{DynamicResource Brush.Primary}"
                                      BorderThickness="1" Background="White" />
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 区块间距（4/8 基数） -->
    <Thickness x:Key="Spacing.CardGap">0,0,0,12</Thickness>
    <Thickness x:Key="Spacing.CardPadding">16</Thickness>
</ResourceDictionary>
