<UserControl x:Class="SpectroscopicAnalysis.Host.Views.ConsolePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 主控台：报警面板 / GNR 光谱仪(占位) / 激光打标面板 / 货架示意(5×8) / 全流程运行日志 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- 标题行 -->
            <DockPanel Margin="{DynamicResource Spacing.CardGap}">
                <TextBlock Text="主控台" Style="{StaticResource Text.PageTitle}" VerticalAlignment="Center" />
            </DockPanel>

            <!-- 当前任务卡（步骤进度占位：抓取→铣削→放置→激发→完成；自生产监控页迁入） -->
            <Border Style="{StaticResource Card}" Margin="{DynamicResource Spacing.CardGap}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="当前任务 #10086" Style="{StaticResource Text.CardTitle}" />
                        <Border Style="{StaticResource Badge.Base}" Background="{DynamicResource Brush.Badge.Running.Bg}" HorizontalAlignment="Right">
                            <TextBlock Text="● 激发中" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Status.Running}" />
                        </Border>
                    </DockPanel>
                    <!-- StepBar 占位（图标白名单：节点 24px） -->
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,8">
                        <StackPanel.Resources>
                            <Style x:Key="StepNode" TargetType="Border">
                                <Setter Property="Width" Value="24" />
                                <Setter Property="Height" Value="24" />
                                <Setter Property="CornerRadius" Value="12" />
                                <Setter Property="BorderThickness" Value="2" />
                            </Style>
    <!-- 步骤标签：功能性文字禁用灰体字，一律主文字色 -->
    <Style x:Key="StepLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
                            <Style x:Key="StepConn" TargetType="Border">
                                <Setter Property="Height" Value="2" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="Margin" Value="8,11,8,0" />
                                <Setter Property="Background" Value="{DynamicResource Brush.Border.Default}" />
                            </Style>
                        </StackPanel.Resources>
                        <StackPanel>
                            <Border Style="{StaticResource StepNode}" Background="{DynamicResource Brush.Status.Running}" BorderBrush="{DynamicResource Brush.Status.Running}">
                                <TextBlock Text="✓" Style="{StaticResource Text.Caption}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="抓取" Style="{StaticResource StepLabel}" />
                        </StackPanel>
                        <Border Style="{StaticResource StepConn}" Width="60" Background="{DynamicResource Brush.Status.Running}" />
                        <StackPanel>
                            <Border Style="{StaticResource StepNode}" Background="{DynamicResource Brush.Status.Running}" BorderBrush="{DynamicResource Brush.Status.Running}">
                                <TextBlock Text="✓" Style="{StaticResource Text.Caption}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="铣削（人工跳过）" Style="{StaticResource StepLabel}" />
                        </StackPanel>
                        <Border Style="{StaticResource StepConn}" Width="60" Background="{DynamicResource Brush.Status.Running}" />
                        <StackPanel>
                            <Border Style="{StaticResource StepNode}" Background="{DynamicResource Brush.Bg.Card}" BorderBrush="{DynamicResource Brush.Primary}">
                                <TextBlock Text="4" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="放置/激发" Style="{StaticResource StepLabel}" />
                        </StackPanel>
                        <Border Style="{StaticResource StepConn}" Width="60" />
                        <StackPanel>
                            <Border Style="{StaticResource StepNode}" Background="{DynamicResource Brush.Bg.Card}" BorderBrush="{DynamicResource Brush.Text.Primary}">
                                <TextBlock Text="5" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="完成/归档" Style="{StaticResource StepLabel}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="激发台力控下压完成，等待 GNR RESULT_REQUEST…（占位）" Style="{StaticResource Text.Caption}" />
                </StackPanel>
            </Border>

            <!-- 顶行三列：GNR 光谱仪(占位) | 激光打标面板 | 货架示意(5×8) -->
            <Grid Margin="{DynamicResource Spacing.CardGap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" MinWidth="240" />
                    <ColumnDefinition Width="1*" MinWidth="240" />
                    <ColumnDefinition Width="1.4*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <!-- 列0：GNR 光谱仪（静态占位，真实协议 100 接入后联动） -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                <Border DockPanel.Dock="Right" Style="{StaticResource Badge.Base}" Background="{DynamicResource Brush.Badge.Running.Bg}">
                                    <TextBlock Text="● 在线" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Status.Running}" />
                                </Border>
                                <TextBlock Text="GNR 光谱仪" Style="{StaticResource Text.CardTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="工作状态" Style="{StaticResource Text.Caption}" Margin="0,0,16,4" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="—" Style="{StaticResource Text.Base}" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="当前样品" Style="{StaticResource Text.Caption}" Margin="0,0,16,4" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="—" Style="{StaticResource Text.Base}" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="最近激发" Style="{StaticResource Text.Caption}" Margin="0,0,16,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="—" Style="{StaticResource Text.Base}" />
                            </Grid>
                            <TextBlock Text="等待 GNR 协议（100 STATUS）接入后联动" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                <!-- 列1：激光打标面板（完整功能：方式切换联动 EzCad2、内容编辑即写回、重新加载；原独立页面能力并入） -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,6,0">
                        <StackPanel DataContext="{Binding Laser}">
                            <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                <Border DockPanel.Dock="Right">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Badge.Base}">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Failed.Bg}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Badge.Running.Bg}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <!-- 文案/前景随在线状态切换（默认离线红，在线绿；文案须由样式 Setter 提供——本地值优先级高于触发器会盖掉切换） -->
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Failed}" />
                                                <Setter Property="Text" Value="● 离线" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Running}" />
                                                        <Setter Property="Text" Value="● 在线" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="激光打标" Style="{StaticResource Text.CardTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="打标方式" Style="{StaticResource Text.Caption}" Width="72" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding MarkingModes}" SelectedItem="{Binding MarkingMode}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="打标文本" Style="{StaticResource Text.Caption}" Width="72" VerticalAlignment="Center" />
                                <TextBox Width="200" Height="32" VerticalAlignment="Center"
                                         Text="{Binding MarkingContent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                <Button Content="重新加载" Style="{StaticResource ModeBtn}"
                                        Command="{Binding ReloadContentCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding SaveStatus}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </Border>

                <!-- 列2：货架示意（5 行×8 列，占用=蓝底显示架位号，空闲=描边；示意外架位单独计数） -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,0,0,0">
                    <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <DockPanel Margin="0,0,0,8" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                                       Text="{Binding RackOutOfRangeCount, StringFormat='示意范围外占用 {0} 位'}" />
                            <TextBlock Text="货架示意（A–E × 1–8）" Style="{StaticResource Text.CardTitle}" VerticalAlignment="Center" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding RackRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding RowLabel}" Style="{StaticResource Text.Caption}" Width="20"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <ItemsControl ItemsSource="{Binding Slots}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,6,0" Padding="8,4" CornerRadius="4" BorderThickness="1" MinWidth="56"
                                                            ToolTip="{Binding SampleIdText}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.Badge.Idle.Bg}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                                                                <Style.Triggers>
                                                                    <!-- 库位状态着色：蓝=可用 / 黄=需测高 / 红=禁用 / 灰=空位 -->
                                                                    <DataTrigger Binding="{Binding SlotState}" Value="Normal">
                                                                        <Setter Property="Background" Value="{DynamicResource Brush.Badge.Info.Bg}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Badge.Info.Bg}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SlotState}" Value="NeedMeasure">
                                                                        <Setter Property="Background" Value="{DynamicResource Brush.Badge.Warning.Bg}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Badge.Warning.Bg}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SlotState}" Value="Disabled">
                                                                        <Setter Property="Background" Value="{DynamicResource Brush.Badge.Failed.Bg}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Badge.Failed.Bg}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock HorizontalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SlotState}" Value="Normal">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.Info.Fg}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding SlotState}" Value="NeedMeasure">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.Warning.Fg}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding SlotState}" Value="Disabled">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.Failed.Fg}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <Run Text="{Binding PositionCode, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                   Text="{Binding RackOccupiedCount, StringFormat='占用 {0} / {1} 位'}" />
                    </StackPanel>

                    <!-- 图例：模块右侧纵向排列（色块 + 语义） -->
                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                        <StackPanel.Resources>
                            <Style x:Key="LegendItem" TargetType="StackPanel">
                                <Setter Property="Orientation" Value="Horizontal" />
                                <Setter Property="Margin" Value="0,3,0,3" />
                            </Style>
                            <Style x:Key="LegendSwatch" TargetType="Border">
                                <Setter Property="Width" Value="14" />
                                <Setter Property="Height" Value="14" />
                                <Setter Property="CornerRadius" Value="3" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="0,0,6,0" />
                            </Style>
                        </StackPanel.Resources>
                        <StackPanel Style="{StaticResource LegendItem}">
                            <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource Brush.Badge.Info.Bg}" />
                            <TextBlock Text="可用" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource LegendItem}">
                            <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource Brush.Badge.Warning.Bg}" />
                            <TextBlock Text="需测高" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource LegendItem}">
                            <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource Brush.Badge.Failed.Bg}" />
                            <TextBlock Text="禁用" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource LegendItem}">
                            <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource Brush.Badge.Idle.Bg}" />
                            <TextBlock Text="空位" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 运行日志（全流程） + 报警面板：同一容器左右排列 -->
            <Grid Margin="{DynamicResource Spacing.CardGap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" MinWidth="360" />
                    <ColumnDefinition Width="1*" MinWidth="300" />
                </Grid.ColumnDefinitions>

            <!-- 全流程运行日志：SystemLogCollector（应用/PLC连接/VM方案加载/设备操作/报警），最新在前 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="运行日志（全流程）" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8" />
                    <TextBlock Text="暂无日志记录" Style="{StaticResource Text.Caption}"
                               Visibility="{Binding HasSystemLogs, Converter={StaticResource BoolToVisibility.Inverse}}" Margin="0,0,0,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320"
                                  Visibility="{Binding HasSystemLogs, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding SystemLogRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource Text.Caption}"
                                                       FontFamily="Consolas" Width="152" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource Badge.Base}" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CategoryText}" Style="{StaticResource Text.Caption}" />
                                            </Border>
                                            <TextBlock Text="{Binding MessageText}" VerticalAlignment="Center" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Warning}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Failed">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Failed}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>



            <!-- 报警面板（ErrorCollector 内存报警表，最新在前；单条/全部确认） -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UnackAlarmCount, StringFormat='未确认 {0}'}" Style="{StaticResource Text.Caption}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Content="全部确认" Command="{Binding AckAllAlarmsCommand}" Style="{StaticResource SecondaryBtn}" Padding="10,5" />
                        </StackPanel>
                        <TextBlock Text="报警面板" Style="{StaticResource Text.CardTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="暂无报警记录" Style="{StaticResource Text.Caption}"
                               Visibility="{Binding HasAlarms, Converter={StaticResource BoolToVisibility.Inverse}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300"
                                  Visibility="{Binding HasAlarms, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding AlarmRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="12,10" HorizontalAlignment="Stretch">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Badge.Base}">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Badge.Failed.Bg}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAcknowledged}" Value="True">
                                                        <Setter Property="Opacity" Value="0.55" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel LastChildFill="True">
                                            <!-- 重新加载：仅激光打标掉线（9004）条目显示——一键重启 EzCad2 并自动确认本条报警 -->
                                            <Button DockPanel.Dock="Right" Content="重新加载" VerticalAlignment="Center" Margin="8,0,0,0" Padding="8,2"
                                                    Command="{Binding DataContext.ReloadLaserCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding AlarmId}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ErrorCodeText}" Value="9004">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button DockPanel.Dock="Right" Content="确认" VerticalAlignment="Center" Margin="8,0,0,0" Padding="8,2"
                                                    Command="{Binding DataContext.AckAlarmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding AlarmId}"
                                                    Visibility="{Binding IsAcknowledged, Converter={StaticResource BoolToVisibility.Inverse}}" />
                                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Badge.Failed.Fg}"
                                                       Text="{Binding DisplayText, StringFormat=✖ {0}}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>


            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
