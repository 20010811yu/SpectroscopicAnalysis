<UserControl x:Class="SpectroscopicAnalysis.Host.Views.LaserMarkingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 激光打标页：打标方式下拉（文本打印/条码打印，联动 EzCad2 工程切换）+ 打标文本输入框（内容来自 2.txt，修改即写回） -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题行：页标题 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="激光打标" Style="{StaticResource Text.PageTitle}" />
        </Grid>

        <!-- 打标文本卡（规格对齐样品注册表单：输入框宽 280 高 32） -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <!-- 打标方式行 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="打标方式" Style="{StaticResource Text.Caption}" Width="110" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding MarkingModes}" SelectedItem="{Binding MarkingMode}" />
                </StackPanel>

                <!-- 打标文本行（修改即写回 2.txt） -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="打标文本" Style="{StaticResource Text.Caption}" Width="110" VerticalAlignment="Center" />
                    <TextBox Width="280" Height="32" VerticalAlignment="Center"
                             Text="{Binding MarkingContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="重新加载" Style="{StaticResource ModeBtn}"
                            Command="{Binding ReloadContentCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <!-- 状态提示（保存/切换结果） -->
                <TextBlock Text="{Binding SaveStatus}" Style="{StaticResource Text.Caption}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
