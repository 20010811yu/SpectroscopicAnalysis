<UserControl x:Class="SpectroscopicAnalysis.Host.Views.ProductionMonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- 标题行 -->
            <DockPanel Margin="{DynamicResource Spacing.CardGap}">
                <TextBlock Text="生产监控" Style="{StaticResource Text.PageTitle}" VerticalAlignment="Center" />
                <Border Style="{StaticResource Badge.Base}" Background="{DynamicResource Brush.Badge.Running.Bg}" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="● 系统运行中 · Auto" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Status.Running}" />
                </Border>
            </DockPanel>

            <!-- 当前任务卡已迁至主控台页顶部（占位模块原样搬移） -->

            <!-- KPI 三卡（弹性：等比例列） -->
            <Grid Margin="{DynamicResource Spacing.CardGap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,6,0" Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="{Binding TodayCompletedCount}" Style="{StaticResource Text.Display}" Foreground="{DynamicResource Brush.Status.Running}" HorizontalAlignment="Center" />
                        <TextBlock Text="今日已完成" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0" Grid.Column="1">
                    <StackPanel>
                        <TextBlock Text="{Binding QueuePendingCount}" Style="{StaticResource Text.Display}" HorizontalAlignment="Center" />
                        <TextBlock Text="队列待分析" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,0,0" Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="{Binding ControlCountdownText}" Style="{StaticResource Text.Display}" Foreground="{DynamicResource Brush.Primary}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ControlCountdownTitle}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 任务队列卡：策略引擎队列真实快照（优先级序，同优先级 FIFO） -->
            <Border Style="{StaticResource Card}" Margin="{DynamicResource Spacing.CardGap}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="任务队列" Style="{StaticResource Text.CardTitle}" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="＋ 样品注册" Command="{Binding OpenSampleRegisterCommand}"
                                Style="{StaticResource PrimaryBtn}" Padding="10,4" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding QueueTotalCount, StringFormat='排队 {0} 个任务'}"
                                   Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="队列为空（注册样品或手动触发后将加入队列）" Style="{StaticResource Text.Caption}"
                               Visibility="{Binding HasQueueItems, Converter={StaticResource BoolToVisibility.Inverse}}" Margin="0,0,0,4" />
                    <!-- 表格化任务队列：复用统一表格样式（GridRow/GridCell/GridCellText），无横线；状态列固定最右 -->
                    <DataGrid ItemsSource="{Binding QueueItems}" Visibility="{Binding HasQueueItems, Converter={StaticResource BoolToVisibility}}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserSortColumns="False"
                              CanUserResizeColumns="True" CanUserResizeRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent"
                              RowStyle="{StaticResource GridRow}" CellStyle="{StaticResource GridCell}"
                              ColumnHeaderStyle="{StaticResource GridColumnHeader}"
                              FontSize="{DynamicResource FontSize.Body}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="样品编号" Binding="{Binding SampleIdText}" FontFamily="Consolas" Width="1.0*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="样品名称" Binding="{Binding SampleNameText}" Width="1.1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="合金" Binding="{Binding AlloyTypeText}" Width="0.7*" MinWidth="40" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="任务类型" Binding="{Binding TaskTypeText}" Width="1.0*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="触发方式" Binding="{Binding ReasonText}" Width="1.3*" MinWidth="80" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="注册时间" Binding="{Binding EnqueueTimeText}" FontFamily="Consolas" Width="0.9*" MinWidth="70" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTemplateColumn Header="状态" Width="0.8*" MinWidth="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" Margin="0,2"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Badge.Base}">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Badge.Info.Bg}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="失败">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Failed.Bg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="已完成">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Idle.Bg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Running.Bg}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusText}" Value="失败">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Failed}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Running}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- 操作：排队中的生产任务可手动置顶（SCT 任务保持 P29 自动调度；执行中不可调整） -->
                            <DataGridTemplateColumn Header="操作" Width="0.7*" MinWidth="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="置顶" Command="{Binding DataContext.MoveTaskTopCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding TaskId}" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanMoveTop}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- 队列分页脚（每页 10 条，超过一页才显示；右下角） -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"
                                Visibility="{Binding HasQueueMultiPage, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="首页" Command="{Binding FirstQueuePageCommand}" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" />
                        <Button Content="上一页" Command="{Binding PrevQueuePageCommand}" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding QueuePageDisplay}" VerticalAlignment="Center" Margin="8,0"
                                   Style="{StaticResource Text.Caption}" />
                        <TextBox Width="48" Height="26" Text="{Binding QueuePageJumpInput, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" TextAlignment="Center" Margin="4,0,0,0" />
                        <Button Content="跳转" Command="{Binding JumpToQueuePageCommand}" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0" />
                        <Button Content="下一页" Command="{Binding NextQueuePageCommand}" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 运行日志（按日期筛选）：SCT 操作日志，时间列末列、按操作时间倒序，无记录时隐藏表格只留占位说明 -->
            <Border Style="{StaticResource Card}" Margin="{DynamicResource Spacing.CardGap}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="操作日期" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <DatePicker SelectedDate="{Binding SelectedDate}" MinWidth="140" />
                        </StackPanel>
                        <TextBlock Text="生产日志（按日期）" Style="{StaticResource Text.CardTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <!-- 类型筛选：按样品类型过滤日志（无样品归属的日志仅在"全部"下显示） -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="全部" Command="{Binding SetFilterCommand}" CommandParameter="All" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilterKey}" Value="All">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="控样" Command="{Binding SetFilterCommand}" CommandParameter="SettingUp" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilterKey}" Value="SettingUp">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="检查样" Command="{Binding SetFilterCommand}" CommandParameter="Control" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilterKey}" Value="Control">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="类型标准化样" Command="{Binding SetFilterCommand}" CommandParameter="TypeStd" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilterKey}" Value="TypeStd">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="生产样" Command="{Binding SetFilterCommand}" CommandParameter="Production" Margin="0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilterKey}" Value="Production">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="所选日期暂无运行日志记录" Style="{StaticResource Text.Caption}"
                               Visibility="{Binding HasLogs, Converter={StaticResource BoolToVisibility.Inverse}}" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding LogRows}" Height="500" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                              PreviewMouseWheel="ProductionGrid_PreviewMouseWheel"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent"
                              Visibility="{Binding HasLogs, Converter={StaticResource BoolToVisibility}}"
                              RowStyle="{StaticResource GridRow}" CellStyle="{StaticResource GridCell}"
                              ColumnHeaderStyle="{StaticResource GridColumnHeader}"
                              MouseDoubleClick="LogGrid_MouseDoubleClick"
                              FontSize="{DynamicResource FontSize.Body}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="样品" Binding="{Binding SampleIdText}" FontFamily="Consolas" Width="1*" MinWidth="70" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="操作类型" Binding="{Binding OperationTypeText}" Width="0.9*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="触发原因" Binding="{Binding TriggerReasonText}" Width="1.4*" MinWidth="70" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="结果状态" Binding="{Binding ResultStatusText}" Width="0.9*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="开始时间" Binding="{Binding StartTimeText}" FontFamily="Consolas" Width="1*" MinWidth="70" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="完成时间" Binding="{Binding OperationTimeText}" FontFamily="Consolas" Width="1*" MinWidth="70" ElementStyle="{StaticResource GridCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- 分页脚（内存切片分页，每页 10 条；右下角。WrapPanel：窄窗口自动折行防溢出） -->
                    <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0"
                               Visibility="{Binding HasLogs, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="首页" Command="{Binding FirstPageCommand}" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" />
                        <Button Content="上一页" Command="{Binding PrevPageCommand}" Style="{StaticResource PrimaryBtn}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding PageDisplay}" VerticalAlignment="Center" Margin="8,0,8,4"
                                   Style="{StaticResource Text.Caption}" />
                        <TextBox Width="48" Height="26" Text="{Binding PageJumpInput, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" TextAlignment="Center" Margin="0,0,0,4" />
                        <Button Content="跳转" Command="{Binding JumpToPageCommand}" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,4" />
                        <Button Content="下一页" Command="{Binding NextPageCommand}" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,4" />
                        <TextBlock Text="{Binding TotalCount, StringFormat='共 {0} 条'}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="8,0,0,4" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
