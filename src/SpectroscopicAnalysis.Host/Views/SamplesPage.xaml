<UserControl x:Class="SpectroscopicAnalysis.Host.Views.SamplesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 样品档案：数据绑定视图（真实 SQLite 数据；状态徽章经 Status DataTrigger 切换颜色） -->
    <UserControl.Resources>
        <!-- 表格行/单元格/列头样式与通用按钮（PrimaryBtn/DangerBtn/SecondaryBtn）均在 Themes/Styles.xaml 定义 -->
    </UserControl.Resources>
    <!-- 页面分区布局：台账表格占满剩余高度（Star），生产样品卡片固定在最下方 -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="{DynamicResource Spacing.CardGap}">
                <TextBlock Text="样品档案" Style="{StaticResource Text.PageTitle}" VerticalAlignment="Center" />
                <!-- 样品注册入口：固定右上角，不随数据表切换显隐；点击切回样品台账表并展开注册表单 -->
                <Button Content="＋ 样品注册" Command="{Binding ToggleRegisterCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource PrimaryBtn}" Padding="10,5" />
            </DockPanel>

            <!-- 样品注册表单（先选类型再显字段：生产样默认；面板展开期间切表不收起） -->
            <Border Grid.Row="1" Margin="{DynamicResource Spacing.CardGap}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <!-- 仅由展开开关控制：切换数据表不收起注册面板 -->
                            <DataTrigger Binding="{Binding IsRegisterOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="样品注册" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,12" />
                    <StackPanel>
                        <StackPanel.Resources>
                            <!-- 表单输入统一尺寸：宽 280 高 32（BasedOn 全局默认样式， HandyControl 外观一致）；
                                 显隐只挂在行容器上，输入控件不再叠加显隐样式，避免覆盖默认外观导致样式不一 -->
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Width" Value="280" />
                                <Setter Property="Height" Value="32" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Setter Property="Width" Value="280" />
                                <Setter Property="Height" Value="32" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <!-- 行级显隐：生产样仅分析方法组；控样/检查样/类型标准样共用架位/厚度组；关联合金仅类型标准样 -->
                            <Style x:Key="ProductionRow" TargetType="FrameworkElement">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RegSampleType}" Value="Production">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="StdRow" TargetType="FrameworkElement">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RegSampleType}" Value="SettingUp">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RegSampleType}" Value="Control">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RegSampleType}" Value="TypeStd">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                            <!-- 架位行：四类样品均必选（生产样注册即确定分析样货架位置） -->
                            <Style x:Key="RackRow" TargetType="FrameworkElement">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RegSampleType}" Value="Production">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RegSampleType}" Value="SettingUp">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RegSampleType}" Value="Control">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RegSampleType}" Value="TypeStd">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="TypeStdRow" TargetType="FrameworkElement">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RegSampleType}" Value="TypeStd">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                            <!-- 仅检查样：兼任类型标准化样勾选行 -->
                            <Style x:Key="ControlRow" TargetType="FrameworkElement">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RegSampleType}" Value="Control">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Resources>

                        <!-- 第一步：类型选择 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="样品类型*" Style="{StaticResource Text.Caption}" Width="110" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding SampleTypeOptions}" SelectedItem="{Binding RegSampleType}" />
                        </StackPanel>
                        <!-- 公共字段：编号/名称 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="样品编号*" Style="{StaticResource Text.Caption}" Width="110" VerticalAlignment="Center" />
                            <TextBox Text="{Binding RegSampleId, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="样品名称*" Style="{StaticResource Text.Caption}" Width="110" VerticalAlignment="Center" Margin="24,0,0,0" />
                            <TextBox Text="{Binding RegSampleName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <!-- 生产样：分析方法下拉 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Style="{StaticResource ProductionRow}">
                            <TextBlock Text="分析方法*" Style="{StaticResource Text.Caption}" Width="110" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding AnalysisMethodOptions}" SelectedItem="{Binding RegAnalysisMethod}" />
                        </StackPanel>
                        <!-- 生产样：合金类型（必填；与类型标准样「关联合金」共用 RegAlloyType，按类型互斥显示） -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Style="{StaticResource ProductionRow}">
                            <TextBlock Text="合金类型*" Style="{StaticResource Text.Caption}" Width="110" VerticalAlignment="Center" />
                            <TextBox Text="{Binding RegAlloyType, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <!-- 架位（四类样品均必选，下拉仅当前空闲架位）+ 最大使用次数（仅 SCT 样） -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Style="{StaticResource RackRow}">
                            <TextBlock Text="样品架位置*" Style="{StaticResource Text.Caption}" Width="110" VerticalAlignment="Center" />
                            <StackPanel>
                                <ComboBox ItemsSource="{Binding RegCurrentRackOptions}" SelectedItem="{Binding RegRackPosition}" MinWidth="110" />
                                <!-- SCT 货架已满提示（A01–E05 无空闲架位时红字；生产样不显示） -->
                                <TextBlock Text="{Binding RegRackFullHint}" Foreground="{DynamicResource Brush.Status.Failed}"
                                           TextWrapping="Wrap" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                            <Setter Property="Margin" Value="0,2,0,0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RegRackFullHint}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Style="{StaticResource StdRow}" Margin="24,0,0,0">
                                <TextBlock Text="最大使用次数*" Style="{StaticResource Text.Caption}" Width="110" VerticalAlignment="Center" />
                                <TextBox Text="{Binding RegMaxUsageCount, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                        <!-- 控样/检查样/类型标准样：初始/最小厚度 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Style="{StaticResource StdRow}">
                            <TextBlock Text="初始厚度 (mm)*" Style="{StaticResource Text.Caption}" Width="110" VerticalAlignment="Center" />
                            <TextBox Text="{Binding RegInitialThickness, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="最小厚度 (mm)*" Style="{StaticResource Text.Caption}" Width="110" VerticalAlignment="Center" Margin="24,0,0,0" />
                            <TextBox Text="{Binding RegMinThickness, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <!-- 仅类型标准样：关联合金 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Style="{StaticResource TypeStdRow}">
                            <TextBlock Text="关联合金*" Style="{StaticResource Text.Caption}" Width="110" VerticalAlignment="Center" />
                            <TextBox Text="{Binding RegAlloyType, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <!-- 仅检查样：兼任类型标准化样（勾选后合金必填，同批创建孪生档案） -->
                        <StackPanel Orientation="Vertical" Margin="0,0,0,8" Style="{StaticResource ControlRow}">
                            <CheckBox Content="兼任类型标准化样（同一物理样品，将同时创建孪生档案：编号 -T 后缀、同架位，合金必填）"
                                      IsChecked="{Binding RegRegisterAsTypeStdTwin}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="关联合金*" Style="{StaticResource Text.Caption}" Width="110" VerticalAlignment="Center" />
                                <TextBox Text="{Binding RegAlloyType, UpdateSourceTrigger=PropertyChanged}" MinWidth="160" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding RegisterError}" TextWrapping="Wrap" Margin="0,4,0,8"
                               Foreground="{DynamicResource Brush.Status.Failed}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RegisterError}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Command="{Binding CancelRegisterCommand}" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" />
                        <Button Content="确认入库" Command="{Binding RegisterCommand}"
                                Style="{StaticResource PrimaryBtn}" Padding="14,6" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 关键词查询（对当前激活数据表生效，关键词按表独立记忆）+ 类型筛选/状态筛选（仅样品台账表显示） -->
            <DockPanel Grid.Row="2" Margin="{DynamicResource Spacing.CardGap}">
                <!-- 统一搜索框：绑定按表路由的 SearchText，切表时内容与提示词随表切换 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="12,0,0,0">
                    <Grid Width="200" VerticalAlignment="Center">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <!-- 搜索框内回车即查询（与「查询」按钮同命令） -->
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <!-- 水印提示词：随激活表切换，有关键词时隐藏 -->
                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Text="{Binding SearchHint}"
                                   Foreground="{DynamicResource Brush.Text.Disabled}"
                                   FontSize="{DynamicResource FontSize.Body}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSearchText}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Content="查询" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0" Padding="14,5" />
                </StackPanel>
                <!-- 类型筛选（仅样品台账表显示） -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsSampleTable, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="全部" Command="{Binding SetFilterCommand}" CommandParameter="All" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterKey}" Value="All">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="控样" Command="{Binding SetFilterCommand}" CommandParameter="SettingUp" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterKey}" Value="SettingUp">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="检查样" Command="{Binding SetFilterCommand}" CommandParameter="Control" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterKey}" Value="Control">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="类型标准化样" Command="{Binding SetFilterCommand}" CommandParameter="TypeStd" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterKey}" Value="TypeStd">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                </StackPanel>
                <!-- 状态筛选（下拉选择；与类型筛选组合生效；仅样品台账表显示） -->
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0"
                            Visibility="{Binding IsSampleTable, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="状态" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="130" ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding StatusFilter}"
                              SelectedValuePath="Key" DisplayMemberPath="DisplayName" />
                </StackPanel>
                <!-- 生产样档案筛选（状态 + 入库日期日历；仅生产样档案表显示） -->
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0"
                            Visibility="{Binding IsProductionSampleTable, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="状态" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="130" ItemsSource="{Binding ProductionStatusOptions}"
                              SelectedItem="{Binding ProductionStatusFilter}"
                              SelectedValuePath="Key" DisplayMemberPath="DisplayName" />
                    <TextBlock Text="入库日期" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="16,0,8,0" />
                    <!-- 参照生产监控页操作日期筛选：单日 DatePicker，清空日期即显示全部 -->
                    <DatePicker SelectedDate="{Binding ProductionDateFilter}" MinWidth="140"
                                VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <!-- 两个独立模块：左=表格卡（标题+表格+分页脚），右=样品详情卡（高度与左卡同行 Stretch 平齐）；
                 其余 5 张数据表激活时左卡跨两列全宽、右详情卡隐藏 -->
            <Grid Grid.Row="3" Margin="{DynamicResource Spacing.CardGap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" MinWidth="420" />
                    <ColumnDefinition Width="0.9*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <!-- 左模块：表格卡片 -->
                <Border Grid.Column="0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Grid.ColumnSpan" Value="2" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTable}" Value="Sample">
                                    <Setter Property="Grid.ColumnSpan" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActiveTable}" Value="ProductionSample">
                                    <Setter Property="Grid.ColumnSpan" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="{Binding ActiveTableDisplay}" Style="{StaticResource Text.CardTitle}" />
                        <!-- 数据表切换（5 张表；标准值/控制限可删，系数/日志只读） -->
                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                            <TextBlock Text="数据表" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Width="250" ItemsSource="{Binding TableOptions}"
                                      SelectedValue="{Binding ActiveTable}"
                                      SelectedValuePath="Key" DisplayMemberPath="DisplayName" />
                        </StackPanel>
                        <TextBlock Text="{Binding DeleteError}" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Brush.Status.Failed}" TextWrapping="Wrap" MaxWidth="600">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                    <!-- 表格撑满卡片剩余高度（行 3 为 Star），行高不随窗口压缩，纵向不足时内部滚动；
                         5 个表格同格叠放，按 ActiveTable 切换可见性 -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding SctSamples}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False"
                              x:Name="LedgerGrid"
                              LayoutUpdated="LedGrid_LayoutUpdated"
                              IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                              CanUserResizeColumns="True" CanUserResizeRows="False"
                              ScrollViewer.CanContentScroll="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent"
                              RowStyle="{StaticResource GridRow}" CellStyle="{StaticResource GridCell}"
                              ColumnHeaderStyle="{StaticResource GridColumnHeader}"
                              FontSize="{DynamicResource FontSize.Body}">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTable}" Value="Sample">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <!-- 列宽按比例（Star）随窗口自动伸缩；≤125% 时操作列固定最右，>125% 由 code-behind 切 Auto -->
                            <DataGridTextColumn Header="SampleID" Binding="{Binding SampleId}" FontFamily="Consolas" Width="1.1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeDisplay}" Width="0.9*" MinWidth="50" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="合金" Binding="{Binding AlloyType}" Width="0.7*" MinWidth="40" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="兼任类型" Binding="{Binding PairText}" FontFamily="Consolas" Width="0.9*" MinWidth="55" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="当前/初始厚度 (mm)" Binding="{Binding ThicknessText}" Width="1.5*" MinWidth="80" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="最小厚度" Binding="{Binding MinThicknessText}" Width="0.8*" MinWidth="50" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="使用次数" Binding="{Binding UsageText}" Width="0.9*" MinWidth="50" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTemplateColumn Header="状态">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" Margin="0,2"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Badge.Base}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Normal">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Running.Bg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="NeedMeasure">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Warning.Bg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Failed.Bg}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Normal">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Running}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="NeedMeasure">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.Warning.Fg}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Failed}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="上次使用" Binding="{Binding LastUseText}" FontFamily="Consolas" Width="1.1*" MinWidth="70" ElementStyle="{StaticResource GridCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 标准值表（SCT_CertifiedValue；可删除） -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CertifiedValues}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                              CanUserResizeColumns="True" CanUserResizeRows="False"
                              ScrollViewer.CanContentScroll="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent"
                              RowStyle="{StaticResource GridRow}" CellStyle="{StaticResource GridCell}"
                              ColumnHeaderStyle="{StaticResource GridColumnHeader}"
                              FontSize="{DynamicResource FontSize.Body}">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTable}" Value="CertifiedValue">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SampleID" Binding="{Binding SampleId}" FontFamily="Consolas" Width="1.2*" MinWidth="80" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="元素" Binding="{Binding Element}" Width="1*" MinWidth="50" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="标准值" Binding="{Binding ValueText}" Width="1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="0.6*" MinWidth="40" ElementStyle="{StaticResource GridCellText}" />
