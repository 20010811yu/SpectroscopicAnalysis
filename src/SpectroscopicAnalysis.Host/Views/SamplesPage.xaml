                    </DataGrid>

                    <!-- 控制限表（ControlLimit；可删除） -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ControlLimitRows}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                              CanUserResizeColumns="True" CanUserResizeRows="False"
                              ScrollViewer.CanContentScroll="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent"
                              RowStyle="{StaticResource GridRow}" CellStyle="{StaticResource GridCell}"
                              ColumnHeaderStyle="{StaticResource GridColumnHeader}"
                              FontSize="{DynamicResource FontSize.Body}">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTable}" Value="ControlLimit">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SampleID" Binding="{Binding SampleId}" FontFamily="Consolas" Width="1.2*" MinWidth="80" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="元素" Binding="{Binding Element}" Width="1*" MinWidth="50" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="上限" Binding="{Binding UpperText}" Width="1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="下限" Binding="{Binding LowerText}" Width="1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="限类型" Binding="{Binding LimitTypeText}" Width="1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTemplateColumn Header="操作" Width="88" MinWidth="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="删除" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Style="{StaticResource DangerBtn}"
                                                Command="{Binding DataContext.DeleteControlLimitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 校正系数表（CorrectionCoefficient；版本化数据，可删除） -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CoefficientRows}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                              CanUserResizeColumns="True" CanUserResizeRows="False"
                              ScrollViewer.CanContentScroll="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent"
                              RowStyle="{StaticResource GridRow}" CellStyle="{StaticResource GridCell}"
                              ColumnHeaderStyle="{StaticResource GridColumnHeader}"
                              FontSize="{DynamicResource FontSize.Body}">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTable}" Value="Coefficient">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="系数ID" Binding="{Binding CoeffId}" FontFamily="Consolas" Width="0.8*" MinWidth="50" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="分析方法" Binding="{Binding MethodId}" Width="1.3*" MinWidth="70" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="元素" Binding="{Binding Element}" Width="0.8*" MinWidth="50" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="斜率 a" Binding="{Binding SlopeText}" Width="1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="截距 b" Binding="{Binding InterceptText}" Width="1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                                                        <DataGridTextColumn Header="来源" Binding="{Binding SourceSampleText}" FontFamily="Consolas" Width="1.1*" MinWidth="70" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="当前有效" Binding="{Binding CurrentText}" Width="1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="版本" Binding="{Binding VersionText}" Width="0.6*" MinWidth="40" ElementStyle="{StaticResource GridCellText}" />
<DataGridTextColumn Header="生效时间" Binding="{Binding EffectiveTimeText}" Width="1.3*" MinWidth="80" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTemplateColumn Header="操作" Width="88" MinWidth="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="删除" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Style="{StaticResource DangerBtn}"
                                                Command="{Binding DataContext.DeleteCoefficientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 操作日志表（SCT_OperationLog；审计留痕，可删除） -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding OperationLogRows}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                              CanUserResizeColumns="True" CanUserResizeRows="False"
                              ScrollViewer.CanContentScroll="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent"
                              RowStyle="{StaticResource GridRow}" CellStyle="{StaticResource GridCell}"
                              ColumnHeaderStyle="{StaticResource GridColumnHeader}"
                              FontSize="{DynamicResource FontSize.Body}">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTable}" Value="OperationLog">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日志ID" Binding="{Binding LogId}" FontFamily="Consolas" Width="0.8*" MinWidth="50" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="样品" Binding="{Binding SampleIdText}" FontFamily="Consolas" Width="1.2*" MinWidth="70" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="操作类型" Binding="{Binding OperationTypeText}" Width="1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="触发原因" Binding="{Binding TriggerReasonText}" Width="1.5*" MinWidth="80" ElementStyle="{StaticResource GridCellText}" />
                                                        <DataGridTextColumn Header="结果状态" Binding="{Binding ResultStatusText}" Width="1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
<DataGridTextColumn Header="操作时间" Binding="{Binding OperationTimeText}" FontFamily="Consolas" Width="1.3*" MinWidth="80" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTemplateColumn Header="操作" Width="88" MinWidth="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="删除" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Style="{StaticResource DangerBtn}"
                                                Command="{Binding DataContext.DeleteOperationLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 生产样档案表（Production_Sample）：独立建表的生产样台账 -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ProductionRows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                              ScrollViewer.CanContentScroll="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent"
                              RowStyle="{StaticResource GridRow}" CellStyle="{StaticResource GridCell}"
                              ColumnHeaderStyle="{StaticResource GridColumnHeader}"
                              FontSize="{DynamicResource FontSize.Body}">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTable}" Value="ProductionSample">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SampleID" Binding="{Binding SampleId}" FontFamily="Consolas" Width="1.2*" MinWidth="70" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="样品名称" Binding="{Binding SampleName}" Width="1.2*" MinWidth="70" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="合金" Binding="{Binding AlloyType}" Width="0.7*" MinWidth="40" ElementStyle="{StaticResource GridCellText}" />
                                                        <DataGridTemplateColumn Header="状态" Width="1*" MinWidth="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- 状态徽章：圆角浅底 + 状态色圆点 + 状态色文字（待分析=黄、已完成=绿、分析失败=红） -->
                                        <Border CornerRadius="10" Padding="8,2" Margin="0,2"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                ToolTipService.ToolTip="{Binding FailureReason}">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Badge.Base}">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Badge.Warning.Bg}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Running.Bg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasFailure}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Failed.Bg}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.Warning.Fg}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Running}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasFailure}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Failed}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="入库时间" Binding="{Binding CreatedText}" FontFamily="Consolas" Width="1*" MinWidth="70" ElementStyle="{StaticResource GridCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 分析结果表（Analysis_Result）：原始/校正后浓度双存 + 系数版本可追溯 -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding AnalysisResultRows}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                              ScrollViewer.CanContentScroll="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent"
                              RowStyle="{StaticResource GridRow}" CellStyle="{StaticResource GridCell}"
                              ColumnHeaderStyle="{StaticResource GridColumnHeader}"
                              FontSize="{DynamicResource FontSize.Body}">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTable}" Value="AnalysisResult">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="结果ID" Binding="{Binding ResultIdText}" FontFamily="Consolas" Width="0.8*" MinWidth="55" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="SampleID" Binding="{Binding SampleId}" FontFamily="Consolas" Width="1.2*" MinWidth="70" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="样品名称" Binding="{Binding SampleName}" Width="1.2*" MinWidth="70" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="原始浓度" Binding="{Binding MeasuredText}" FontFamily="Consolas" Width="1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="校正后浓度" Binding="{Binding CorrectedText}" FontFamily="Consolas" Width="1*" MinWidth="65" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="系数版本" Binding="{Binding CoeffVersionText}" FontFamily="Consolas" Width="0.8*" MinWidth="55" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="合格判定" Binding="{Binding PassText}" Width="1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="结果状态" Binding="{Binding ResultStatusText}" Width="1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="归档位置" Binding="{Binding ArchiveText}" FontFamily="Consolas" Width="1*" MinWidth="70" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="操作时间" Binding="{Binding TimeText}" FontFamily="Consolas" Width="1.1*" MinWidth="70" ElementStyle="{StaticResource GridCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 分页脚（每页 15 行；右下角，含页码跳转） -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="首页" Command="{Binding FirstPageCommand}" Style="{StaticResource PrimaryBtn}" />
                        <Button Content="上一页" Command="{Binding PrevPageCommand}" Style="{StaticResource PrimaryBtn}" Margin="4,0,0,0" />
                        <TextBlock Text="{Binding PageDisplay}" VerticalAlignment="Center" Margin="8,0"
                                   Style="{StaticResource Text.Caption}" />
                        <TextBox Width="48" Height="26" Text="{Binding PageJumpInput, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" TextAlignment="Center" Margin="4,0,0,0" />
                        <Button Content="跳转" Command="{Binding JumpToPageCommand}" Style="{StaticResource PrimaryBtn}" Margin="4,0,0,0" />
                        <Button Content="下一页" Command="{Binding NextPageCommand}" Style="{StaticResource PrimaryBtn}" Margin="4,0,0,0" />
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource Text.Caption}">
                            <Run Text="共 " /><Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" 条" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="使用次数达到上限自动标记「需测高」；厚度低于最小厚度自动「禁用」并报警更换；删除经弹窗二次确认（级联删除标准值与控制限，操作日志保留）"
                               Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                               Visibility="{Binding IsSampleTable, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>

                <!-- 右模块：样品详情卡片（仅样品台账/生产样档案两表显示；与左卡同行 Stretch 平齐；未选中时显示引导占位） -->
                <Border Grid.Column="1">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Margin" Value="12,0,0,0" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTable}" Value="Sample">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActiveTable}" Value="ProductionSample">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- 未选中引导（描述性占位） -->
                                <TextBlock Text="点击左侧表格行查看样品详情" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- 详情主体（Detail 非空） -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- 标题行：标题靠左、删除按钮同行最右（仅样品台账详情显示） -->
                                    <DockPanel>
                                        <!-- 手动加入任务队列：仅生产样详情显示，待分析状态才可用 -->
                                        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                                Content="加入队列"
                                                ToolTip="将待分析样品加入生产任务队列（已在队列中时自动去重）"
                                                Command="{Binding JoinQueueCommand}"
                                                CommandParameter="{Binding Detail.SampleId}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="IsEnabled" Value="{Binding Detail.CanJoinQueue}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Detail.Kind}" Value="Production">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                                Content="删除样品"
                                                Command="{Binding DeleteCommand}"
                                                CommandParameter="{Binding SelectedRow}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource DangerBtn}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Detail.Kind}" Value="Sct">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <!-- 生产样详情同样提供删除：级联删除档案+分析结果 -->
                                                        <DataTrigger Binding="{Binding Detail.Kind}" Value="Production">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <TextBlock Style="{StaticResource Text.CardTitle}" TextWrapping="Wrap" VerticalAlignment="Center">
                                            <Run Text="样品详情：" /><Run Text="{Binding Detail.SampleId, Mode=OneWay}" />
                                        </TextBlock>
                                    </DockPanel>
                                    <!-- 加入队列操作反馈：成功绿/失败红（VM 互斥置值；非空才显示） -->
                                    <TextBlock Text="{Binding JoinQueueMessage}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Foreground="{DynamicResource Brush.Status.Running}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding JoinQueueMessage}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding JoinQueueError}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Foreground="{DynamicResource Brush.Status.Failed}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding JoinQueueError}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Badge.Base}">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Detail.Kind}" Value="Sct" />
                                                            <Condition Binding="{Binding Detail.Status}" Value="Normal" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Badge.Running.Bg}" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Detail.Kind}" Value="Sct" />
                                                            <Condition Binding="{Binding Detail.Status}" Value="NeedMeasure" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Badge.Warning.Bg}" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Detail.Kind}" Value="Sct" />
                                                            <Condition Binding="{Binding Detail.Status}" Value="Warning" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Badge.Warning.Bg}" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Detail.Kind}" Value="Sct" />
                                                            <Condition Binding="{Binding Detail.Status}" Value="Disabled" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Badge.Failed.Bg}" />
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding Detail.Status}" Value="Analyzing">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Badge.Running.Bg}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Detail.Status}" Value="Completed">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Badge.Idle.Bg}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Detail.Status}" Value="Failed">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Badge.Failed.Bg}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Detail.StatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Detail.Kind}" Value="Sct" />
                                                                <Condition Binding="{Binding Detail.Status}" Value="Normal" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Running}" />
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Detail.Kind}" Value="Sct" />
                                                                <Condition Binding="{Binding Detail.Status}" Value="NeedMeasure" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.Warning.Fg}" />
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Detail.Kind}" Value="Sct" />
                                                                <Condition Binding="{Binding Detail.Status}" Value="Warning" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.Warning.Fg}" />
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Detail.Kind}" Value="Sct" />
                                                                <Condition Binding="{Binding Detail.Status}" Value="Disabled" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Failed}" />
                                                        </MultiDataTrigger>
                                                        <DataTrigger Binding="{Binding Detail.Status}" Value="Analyzing">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Running}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Detail.Status}" Value="Failed">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Failed}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- 详情字段（标签 Caption + 值，两列 Grid 弹性） -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="72" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.Resources>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                <Setter Property="Margin" Value="0,4" />
                                            </Style>
                                            <!-- 值列：主文字色（功能性文字禁用灰体字） -->
                                            <Style x:Key="DetailValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                                <Setter Property="Margin" Value="12,4,0,4" />
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                            </Style>
                                            <!-- 仅 SCT 样显示的字段（厚度/使用次数等，生产样表无此内容；生产样隐藏避免"—"占位） -->
                                            <Style x:Key="SctOnlyCaption" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                <Setter Property="Margin" Value="0,4" />
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Detail.Kind}" Value="Production">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                            <Style x:Key="SctOnlyValue" TargetType="TextBlock" BasedOn="{StaticResource DetailValue}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Detail.Kind}" Value="Production">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Resources>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="类型" Style="{StaticResource Text.Caption}" Margin="0,4" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Detail.TypeDisplay}" Style="{StaticResource DetailValue}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="关联合金" Style="{StaticResource Text.Caption}" Margin="0,4" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail.AlloyTypeText}" Style="{StaticResource DetailValue}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="架位" Style="{StaticResource SctOnlyCaption}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Detail.RackPositionText}" Style="{StaticResource SctOnlyValue}" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="关联方法" Style="{StaticResource Text.Caption}" Margin="0,4" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Detail.MethodText}" Style="{StaticResource DetailValue}" />

                                        <!-- 失败原因（生产样分析失败时显示，红色；空值隐藏） -->
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="失败原因">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                    <Setter Property="Margin" Value="0,4" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Detail.FailureReasonText}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Detail.FailureReasonText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                                    <Setter Property="Margin" Value="12,4,0,4" />
                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Detail.FailureReasonText}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Detail.Kind}" Value="Production">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Failed}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="当前/初始厚度" Style="{StaticResource SctOnlyCaption}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Detail.ThicknessText}" Style="{StaticResource SctOnlyValue}" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="最小厚度" Style="{StaticResource SctOnlyCaption}" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Detail.MinThicknessText}" Style="{StaticResource SctOnlyValue}" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="使用次数" Style="{StaticResource SctOnlyCaption}" />
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Detail.UsageText}" Style="{StaticResource SctOnlyValue}" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="上次使用" Style="{StaticResource SctOnlyCaption}" />
                                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Detail.LastUseText}" Style="{StaticResource SctOnlyValue}" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="上次测高" Style="{StaticResource SctOnlyCaption}" />
                                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Detail.LastHeightText}" Style="{StaticResource SctOnlyValue}" FontFamily="Consolas" />
                                        <!-- 启用状态（SCT 管理页"禁用标样"只翻转 IsActive，本行让档案详情同步可见；已停用红色提示） -->
                                        <TextBlock Grid.Row="9" Grid.Column="0" Text="启用状态" Style="{StaticResource SctOnlyCaption}" />
                                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Detail.ActiveText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SctOnlyValue}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Detail.ActiveText}" Value="已停用">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Failed}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <!-- SCT 样：标准值子表 -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Detail.Kind}" Value="Sct">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="标准值（CertifiedValues）" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
                                        <ItemsControl ItemsSource="{Binding DetailCertifiedValues}">
                                            <ItemsControl.Template>
                                                <ControlTemplate TargetType="ItemsControl">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <!-- 表头 -->
                                                        <Grid Grid.Row="0" Background="{DynamicResource Brush.Bg.Page}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="元素" Style="{StaticResource Table.Header}" Padding="0,4" />
                                                            <TextBlock Grid.Column="1" Text="标准值 %" Style="{StaticResource Table.Header}" Padding="0,4" />
                                                            <TextBlock Grid.Column="2" Text="不确定度" Style="{StaticResource Table.Header}" Padding="0,4" />
                                                        </Grid>
                                                        <ItemsPresenter Grid.Row="1" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </ItemsControl.Template>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,0,0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Element}" Style="{StaticResource Text.Base}" Padding="0,4" />
                                                            <TextBlock Grid.Column="1" Text="{Binding ValueText}" Style="{StaticResource Text.Base}" Padding="0,4" FontFamily="Consolas" />
                                                            <TextBlock Grid.Column="2" Text="{Binding UncertaintyText}" Style="{StaticResource Text.Base}" Padding="0,4" FontFamily="Consolas" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- 生产样：分析结果子表 -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Detail.Kind}" Value="Production">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="分析结果（Analysis_Result）" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
                                        <ItemsControl ItemsSource="{Binding DetailResults}">
                                            <ItemsControl.Template>
                                                <ControlTemplate TargetType="ItemsControl">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0" Background="{DynamicResource Brush.Bg.Page}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="原始浓度" Style="{StaticResource Table.Header}" Padding="0,4" />
                                                            <TextBlock Grid.Column="1" Text="校正后浓度" Style="{StaticResource Table.Header}" Padding="0,4" />
                                                            <TextBlock Grid.Column="2" Text="判定结果" Style="{StaticResource Table.Header}" Padding="0,4" />
                                                            <TextBlock Grid.Column="3" Text="分析时间" Style="{StaticResource Table.Header}" Padding="0,4" />
                                                        </Grid>
                                                        <ItemsPresenter Grid.Row="1" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </ItemsControl.Template>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- 生产日志跳转的时间匹配行以选中底色高亮（IsLocateHighlighted） -->
                                                    <Border BorderThickness="0,0,0,1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLocateHighlighted}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Row.Selected}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding MeasuredText}" Style="{StaticResource Text.Base}" Padding="0,4" FontFamily="Consolas" />
                                                            <TextBlock Grid.Column="1" Text="{Binding CorrectedText}" Style="{StaticResource Text.Base}" Padding="0,4" FontFamily="Consolas" />
                                                            <TextBlock Grid.Column="2" Text="{Binding PassText}" Style="{StaticResource Text.Base}" Padding="0,4" />
                                                            <TextBlock Grid.Column="3" Text="{Binding TimeText}" Style="{StaticResource Text.Base}" Padding="0,4" FontFamily="Consolas" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- 轨迹日志（仅样品台账详情显示；全量分页 10 条/页；带表头子表：完整时间/操作类型/触发原因/结果状态） -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Detail.Kind}" Value="Sct">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="轨迹日志" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
                                    <ItemsControl ItemsSource="{Binding DetailLogs}">
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0" Background="{DynamicResource Brush.Bg.Page}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="0.8*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="1.3*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="操作类型" Style="{StaticResource Table.Header}" Padding="0,4" />
                                                        <TextBlock Grid.Column="1" Text="触发原因" Style="{StaticResource Table.Header}" Padding="0,4" />
                                                        <TextBlock Grid.Column="2" Text="结果状态" Style="{StaticResource Table.Header}" Padding="0,4" />
                                                        <TextBlock Grid.Column="3" Text="时间" Style="{StaticResource Table.Header}" Padding="0,4" />
                                                    </Grid>
                                                    <ItemsPresenter Grid.Row="1" />
                                                </Grid>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- 生产日志跳转的时间匹配行以选中底色高亮（IsLocateHighlighted） -->
                                                <Border BorderThickness="0,0,0,1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLocateHighlighted}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Bg.Row.Selected}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="0.8*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="1.3*" />
                                                        </Grid.ColumnDefinitions>
                                                                                                                <TextBlock Grid.Column="0" Text="{Binding OperationTypeText}" Style="{StaticResource Text.Base}" Padding="0,4" />
                                                        <TextBlock Grid.Column="1" Text="{Binding TriggerReasonText}" Style="{StaticResource Text.Base}" Padding="0,4" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ResultStatusText}" Padding="8,4">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ResultStatus}" Value="Success">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Running}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ResultStatus}" Value="Warning">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.Warning.Fg}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ResultStatus}" Value="Fail">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Failed}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="3" Text="{Binding OperationTimeText}" Style="{StaticResource Text.Base}" Padding="0,4" FontFamily="Consolas" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- 轨迹日志分页脚（每页 10 行；超 10 条才可翻页） -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                        <Button Content="首页" Command="{Binding FirstDetailLogPageCommand}" Style="{StaticResource PrimaryBtn}" />
                                        <Button Content="上一页" Command="{Binding PrevDetailLogPageCommand}" Style="{StaticResource PrimaryBtn}" Margin="4,0,0,0" />
                                        <TextBlock Text="{Binding DetailLogPageDisplay}" VerticalAlignment="Center" Margin="8,0"
                                                   Style="{StaticResource Text.Caption}" />
                                        <TextBox Width="48" Height="26" Text="{Binding DetailLogPageJumpInput, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalContentAlignment="Center" TextAlignment="Center" Margin="4,0,0,0" />
                                        <Button Content="跳转" Command="{Binding JumpToDetailLogPageCommand}" Style="{StaticResource PrimaryBtn}" Margin="4,0,0,0" />
                                        <Button Content="下一页" Command="{Binding NextDetailLogPageCommand}" Style="{StaticResource PrimaryBtn}" Margin="4,0,0,0" />
                                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource Text.Caption}">
                                            <Run Text="共 " /><Run Text="{Binding DetailLogTotalCount, Mode=OneWay}" /><Run Text=" 条" />
                                        </TextBlock>
                                    </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                </Border>
            </Grid>

    </Grid>
</UserControl>
