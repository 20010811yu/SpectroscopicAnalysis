<UserControl x:Class="SpectroscopicAnalysis.Host.Views.SamplesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 样品档案：数据绑定视图（真实 SQLite 数据；状态徽章经 Status DataTrigger 切换颜色） -->
    <UserControl.Resources>
        <!-- 表格行/单元格/列头样式已上移至 Themes/Styles.xaml（与主控台生产样品表格共用） -->
        <!-- 分页按钮：可用时蓝底白字；禁用时灰底灰字（首/末页状态，由命令 CanExecute 自动切换） -->
        <Style x:Key="PagerBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="4" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Primary.Hover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource Brush.Bg.Disabled}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- 页面分区布局：台账表格占满剩余高度（Star），生产样品卡片固定在最下方 -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="{DynamicResource Spacing.CardGap}">
                <TextBlock Text="样品档案" Style="{StaticResource Text.PageTitle}" VerticalAlignment="Center" />
                <Button Content="＋ 录入新标样" Command="{Binding ToggleRegisterCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="{Binding IsSampleTable, Converter={StaticResource BoolToVisibility}}"
                        Background="{DynamicResource Brush.Primary}" Foreground="White"
                        FontSize="{DynamicResource FontSize.Caption}" Padding="10,5" Cursor="Hand" />
            </DockPanel>

            <!-- 样品注册表单（入库初始化：当前厚度=初始厚度、使用次数=0、状态=Normal；仅样品台账表且面板展开时显示） -->
            <Border Grid.Row="1" Margin="{DynamicResource Spacing.CardGap}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsRegisterOpen}" Value="True" />
                                    <Condition Binding="{Binding IsSampleTable}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="录入新标样" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="样品编号*" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RegSampleId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="样品名称*" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding RegSampleName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="样品类型*" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SampleTypeOptions}" SelectedItem="{Binding RegSampleType}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="合金类型" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding RegAlloyType, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="样品架位置*" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RegRackPosition, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="最大使用次数*" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding RegMaxUsageCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="初始厚度 (mm)*" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RegInitialThickness, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="最小厚度 (mm)*" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding RegMinThickness, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                    </Grid>

                    <TextBlock Text="{Binding RegisterError}" TextWrapping="Wrap" Margin="0,4,0,8"
                               Foreground="{DynamicResource Brush.Status.Failed}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RegisterError}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Command="{Binding CancelRegisterCommand}" Margin="0,0,8,0" />
                        <Button Content="确认入库" Command="{Binding RegisterCommand}"
                                Background="{DynamicResource Brush.Primary}" Foreground="White"
                                FontSize="{DynamicResource FontSize.Caption}" Padding="14,6" Cursor="Hand" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 关键词查询（对当前激活数据表生效）+ 类型筛选/状态筛选（仅样品台账表显示） -->
            <DockPanel Grid.Row="2" Margin="{DynamicResource Spacing.CardGap}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="12,0,0,0">
                    <TextBox Width="200" VerticalAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Style.Resources>
                                    <VisualBrush x:Key="SearchHint" AlignmentX="Left" Stretch="None">
                                        <VisualBrush.Visual>
                                            <TextBlock Text="搜索关键字（编号 / 元素 / 方法等）" Foreground="{DynamicResource Brush.Text.Disabled}"
                                                       FontSize="{DynamicResource FontSize.Body}" />
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Style.Resources>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" Value="{StaticResource SearchHint}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                        <!-- 回车触发查询 -->
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="查询" Command="{Binding SearchCommand}" Margin="8,0,0,0" Padding="14,5"
                            FontSize="{DynamicResource FontSize.Caption}" Cursor="Hand" />
                </StackPanel>
                <!-- 类型筛选（仅样品台账表显示） -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsSampleTable, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="全部" Command="{Binding SetFilterCommand}" CommandParameter="All" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterKey}" Value="All">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="设置样" Command="{Binding SetFilterCommand}" CommandParameter="SettingUp" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterKey}" Value="SettingUp">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="控制样" Command="{Binding SetFilterCommand}" CommandParameter="Control" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterKey}" Value="Control">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="类型标准化样" Command="{Binding SetFilterCommand}" CommandParameter="TypeStd" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterKey}" Value="TypeStd">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                </StackPanel>
                <!-- 状态筛选（下拉选择；与类型筛选组合生效；仅样品台账表显示） -->
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0"
                            Visibility="{Binding IsSampleTable, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="状态" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="130" ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding StatusFilter}"
                              SelectedValuePath="Key" DisplayMemberPath="DisplayName" />
                </StackPanel>
            </DockPanel>

            <!-- SCT 样品台账（真实数据；撑满剩余高度，行高自然，高度不足时表格内部纵向滚动） -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="{DynamicResource Spacing.CardGap}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="{Binding ActiveTableDisplay}" Style="{StaticResource Text.CardTitle}" />
                        <!-- 数据表切换（5 张表；标准值/控制限可删，系数/日志只读） -->
                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                            <TextBlock Text="数据表" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Width="250" ItemsSource="{Binding TableOptions}"
                                      SelectedValue="{Binding ActiveTable}"
                                      SelectedValuePath="Key" DisplayMemberPath="DisplayName" />
                        </StackPanel>
                        <TextBlock Text="{Binding DeleteError}" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Brush.Status.Failed}" TextWrapping="Wrap" MaxWidth="600">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                    <!-- 表格撑满卡片剩余高度（行 3 为 Star），行高不随窗口压缩，纵向不足时内部滚动；
                         5 个表格同格叠放，按 ActiveTable 切换可见性 -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding SctSamples}" AutoGenerateColumns="False"
                              x:Name="LedgerGrid"
                              LayoutUpdated="LedGrid_LayoutUpdated"
                              IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                              CanUserResizeColumns="True" CanUserResizeRows="False"
                              ScrollViewer.CanContentScroll="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent"
                              RowStyle="{StaticResource GridRow}" CellStyle="{StaticResource GridCell}"
                              ColumnHeaderStyle="{StaticResource GridColumnHeader}"
                              FontSize="{DynamicResource FontSize.Body}">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTable}" Value="Sample">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <!-- 列宽按比例（Star）随窗口自动伸缩；≤125% 时操作列固定最右，>125% 由 code-behind 切 Auto -->
                            <DataGridTextColumn Header="SampleID" Binding="{Binding SampleId}" FontFamily="Consolas" Width="1.1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="样品名称" Binding="{Binding SampleName}" Width="1.5*" MinWidth="70" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeDisplay}" Width="0.9*" MinWidth="50" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="合金" Binding="{Binding AlloyType}" Width="0.7*" MinWidth="40" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="架位" Binding="{Binding RackPosition}" Width="0.7*" MinWidth="40" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="关联方法" Binding="{Binding AssociatedMethodText}" Width="1*" MinWidth="50" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="当前/初始厚度 (mm)" Binding="{Binding ThicknessText}" Width="1.5*" MinWidth="80" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="最小厚度" Binding="{Binding MinThicknessText}" Width="0.8*" MinWidth="50" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="使用次数" Binding="{Binding UsageText}" Width="0.9*" MinWidth="50" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTemplateColumn Header="状态">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" Margin="0,2"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Badge.Base}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Normal">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Running.Bg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="NeedMeasure">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Warning.Bg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Warning.Bg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Failed.Bg}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Normal">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Running}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="NeedMeasure">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.Warning.Fg}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.Warning.Fg}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Failed}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="上次使用" Binding="{Binding LastUseText}" Width="1.1*" MinWidth="70" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="上次测高" Binding="{Binding LastHeightText}" Width="1.1*" MinWidth="70" ElementStyle="{StaticResource GridCellText}" />
                            <!-- 删除（弹窗二次确认，行数据保持原样展示） -->
                            <!-- 操作列固定宽度：Star 列占满剩余空间时始终靠在最右侧 -->
                            <DataGridTemplateColumn Header="操作" Width="88" MinWidth="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="删除" Cursor="Hand" Padding="10,3" FontSize="{DynamicResource FontSize.Caption}"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="Transparent" Foreground="{DynamicResource Brush.Danger}"
                                                BorderBrush="{DynamicResource Brush.Danger}" BorderThickness="1"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="MinWidth" Value="0" />
                                                    <Setter Property="MinHeight" Value="0" />
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 标准值表（SCT_CertifiedValue；可删除） -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CertifiedValues}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                              CanUserResizeColumns="True" CanUserResizeRows="False"
                              ScrollViewer.CanContentScroll="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent"
                              RowStyle="{StaticResource GridRow}" CellStyle="{StaticResource GridCell}"
                              ColumnHeaderStyle="{StaticResource GridColumnHeader}"
                              FontSize="{DynamicResource FontSize.Body}">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTable}" Value="CertifiedValue">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SampleID" Binding="{Binding SampleId}" FontFamily="Consolas" Width="1.2*" MinWidth="80" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="元素" Binding="{Binding Element}" Width="1*" MinWidth="50" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="标准值" Binding="{Binding ValueText}" Width="1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="0.6*" MinWidth="40" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="不确定度" Binding="{Binding UncertaintyText}" Width="1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTemplateColumn Header="操作" Width="88" MinWidth="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="删除" Cursor="Hand" Padding="10,3" FontSize="{DynamicResource FontSize.Caption}"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="Transparent" Foreground="{DynamicResource Brush.Danger}"
                                                BorderBrush="{DynamicResource Brush.Danger}" BorderThickness="1"
                                                Command="{Binding DataContext.DeleteCertifiedValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="MinWidth" Value="0" />
                                                    <Setter Property="MinHeight" Value="0" />
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 控制限表（ControlLimit；可删除） -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ControlLimitRows}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                              CanUserResizeColumns="True" CanUserResizeRows="False"
                              ScrollViewer.CanContentScroll="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent"
                              RowStyle="{StaticResource GridRow}" CellStyle="{StaticResource GridCell}"
                              ColumnHeaderStyle="{StaticResource GridColumnHeader}"
                              FontSize="{DynamicResource FontSize.Body}">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTable}" Value="ControlLimit">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SampleID" Binding="{Binding SampleId}" FontFamily="Consolas" Width="1.2*" MinWidth="80" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="元素" Binding="{Binding Element}" Width="1*" MinWidth="50" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="上限" Binding="{Binding UpperText}" Width="1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="下限" Binding="{Binding LowerText}" Width="1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="限类型" Binding="{Binding LimitTypeText}" Width="1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTemplateColumn Header="操作" Width="88" MinWidth="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="删除" Cursor="Hand" Padding="10,3" FontSize="{DynamicResource FontSize.Caption}"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="Transparent" Foreground="{DynamicResource Brush.Danger}"
                                                BorderBrush="{DynamicResource Brush.Danger}" BorderThickness="1"
                                                Command="{Binding DataContext.DeleteControlLimitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="MinWidth" Value="0" />
                                                    <Setter Property="MinHeight" Value="0" />
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 校正系数表（CorrectionCoefficient；版本化数据，可删除） -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CoefficientRows}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                              CanUserResizeColumns="True" CanUserResizeRows="False"
                              ScrollViewer.CanContentScroll="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent"
                              RowStyle="{StaticResource GridRow}" CellStyle="{StaticResource GridCell}"
                              ColumnHeaderStyle="{StaticResource GridColumnHeader}"
                              FontSize="{DynamicResource FontSize.Body}">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTable}" Value="Coefficient">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="系数ID" Binding="{Binding CoeffId}" FontFamily="Consolas" Width="0.8*" MinWidth="50" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="分析方法" Binding="{Binding MethodId}" Width="1.3*" MinWidth="70" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="元素" Binding="{Binding Element}" Width="0.8*" MinWidth="50" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="斜率 a" Binding="{Binding SlopeText}" Width="1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="截距 b" Binding="{Binding InterceptText}" Width="1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="生效时间" Binding="{Binding EffectiveTimeText}" Width="1.3*" MinWidth="80" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="来源设置样" Binding="{Binding SourceSampleText}" FontFamily="Consolas" Width="1.1*" MinWidth="70" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="当前有效" Binding="{Binding CurrentText}" Width="1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="版本" Binding="{Binding VersionText}" Width="0.6*" MinWidth="40" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTemplateColumn Header="操作" Width="88" MinWidth="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="删除" Cursor="Hand" Padding="10,3" FontSize="{DynamicResource FontSize.Caption}"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="Transparent" Foreground="{DynamicResource Brush.Danger}"
                                                BorderBrush="{DynamicResource Brush.Danger}" BorderThickness="1"
                                                Command="{Binding DataContext.DeleteCoefficientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="MinWidth" Value="0" />
                                                    <Setter Property="MinHeight" Value="0" />
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 操作日志表（SCT_OperationLog；审计留痕，可删除） -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding OperationLogRows}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                              CanUserResizeColumns="True" CanUserResizeRows="False"
                              ScrollViewer.CanContentScroll="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent"
                              RowStyle="{StaticResource GridRow}" CellStyle="{StaticResource GridCell}"
                              ColumnHeaderStyle="{StaticResource GridColumnHeader}"
                              FontSize="{DynamicResource FontSize.Body}">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTable}" Value="OperationLog">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日志ID" Binding="{Binding LogId}" FontFamily="Consolas" Width="0.8*" MinWidth="50" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="样品" Binding="{Binding SampleIdText}" FontFamily="Consolas" Width="1.2*" MinWidth="70" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="操作类型" Binding="{Binding OperationTypeText}" Width="1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="触发原因" Binding="{Binding TriggerReasonText}" Width="1.5*" MinWidth="80" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="操作时间" Binding="{Binding OperationTimeText}" FontFamily="Consolas" Width="1.3*" MinWidth="80" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="结果状态" Binding="{Binding ResultStatusText}" Width="1*" MinWidth="60" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTemplateColumn Header="操作" Width="88" MinWidth="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="删除" Cursor="Hand" Padding="10,3" FontSize="{DynamicResource FontSize.Caption}"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="Transparent" Foreground="{DynamicResource Brush.Danger}"
                                                BorderBrush="{DynamicResource Brush.Danger}" BorderThickness="1"
                                                Command="{Binding DataContext.DeleteOperationLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="MinWidth" Value="0" />
                                                    <Setter Property="MinHeight" Value="0" />
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 分页栏（每页 20 条，对当前激活数据表生效；整组靠右） -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="首页" Command="{Binding GoToPageCommand}" CommandParameter="1" Style="{StaticResource PagerBtn}" />
                        <Button Content="上一页" Command="{Binding PrevPageCommand}" Style="{StaticResource PagerBtn}" Margin="4,0,0,0" />
                        <TextBlock Text="{Binding PageDisplay}" VerticalAlignment="Center" Margin="8,0"
                                   Style="{StaticResource Text.Caption}" />
                        <Button Content="下一页" Command="{Binding NextPageCommand}" Style="{StaticResource PagerBtn}" />
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource Text.Caption}">
                            <Run Text="共 " /><Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" 条" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="使用次数达到上限自动标记「需测高」；厚度低于最小厚度自动「禁用」并报警更换；删除经弹窗二次确认（级联删除标准值与控制限，操作日志保留）"
                               Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                               Visibility="{Binding IsSampleTable, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

    </Grid>
</UserControl>
