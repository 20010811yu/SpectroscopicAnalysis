<UserControl x:Class="SpectroscopicAnalysis.Host.Views.SamplesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 样品档案：数据绑定视图（真实 SQLite 数据；状态徽章经 Status DataTrigger 切换颜色） -->
    <UserControl.Resources>
        <!-- 表格行：只读展示，选中不加任何高亮，外观与普通行一致 -->
        <Style x:Key="GridRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 表格单元格：选中保持正文前景与透明底；内容垂直居中、水平靠左（界面规范 5.2） -->
        <Style x:Key="GridCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 文本单元格内容：垂直居中、水平靠左（界面规范 5.2） -->
        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- 列标题：靠左与数据列对齐；无边框无阴影（界面规范 5.2） -->
        <Style x:Key="GridColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="0,0,12,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <DockPanel Margin="{DynamicResource Spacing.CardGap}">
                <TextBlock Text="样品档案" Style="{StaticResource Text.PageTitle}" VerticalAlignment="Center" />
                <Button Content="＋ 录入新标样" Command="{Binding ToggleRegisterCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Primary}" Foreground="White"
                        FontSize="{DynamicResource FontSize.Caption}" Padding="10,5" Cursor="Hand" />
            </DockPanel>

            <!-- 样品注册表单（入库初始化：当前厚度=初始厚度、使用次数=0、状态=Normal） -->
            <Border Style="{StaticResource Card}" Margin="{DynamicResource Spacing.CardGap}"
                    Visibility="{Binding IsRegisterOpen, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="录入新标样" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="样品编号*" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RegSampleId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="样品名称*" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding RegSampleName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="样品类型*" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SampleTypeOptions}" SelectedItem="{Binding RegSampleType}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="合金类型" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding RegAlloyType, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="样品架位置*" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RegRackPosition, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="最大使用次数*" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding RegMaxUsageCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="初始厚度 (mm)*" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RegInitialThickness, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="最小厚度 (mm)*" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding RegMinThickness, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                    </Grid>

                    <TextBlock Text="{Binding RegisterError}" TextWrapping="Wrap" Margin="0,4,0,8"
                               Foreground="{DynamicResource Brush.Status.Failed}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RegisterError}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Command="{Binding CancelRegisterCommand}" Margin="0,0,8,0" />
                        <Button Content="确认入库" Command="{Binding RegisterCommand}"
                                Background="{DynamicResource Brush.Primary}" Foreground="White"
                                FontSize="{DynamicResource FontSize.Caption}" Padding="14,6" Cursor="Hand" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 类型筛选 + 关键词查询 -->
            <DockPanel Margin="{DynamicResource Spacing.CardGap}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="12,0,0,0">
                    <TextBox Width="200" VerticalAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Style.Resources>
                                    <VisualBrush x:Key="SearchHint" AlignmentX="Left" Stretch="None">
                                        <VisualBrush.Visual>
                                            <TextBlock Text="搜索编号 / 名称" Foreground="{DynamicResource Brush.Text.Disabled}"
                                                       FontSize="{DynamicResource FontSize.Body}" />
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Style.Resources>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" Value="{StaticResource SearchHint}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                        <!-- 回车触发查询 -->
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="查询" Command="{Binding SearchCommand}" Margin="8,0,0,0" Padding="14,5"
                            FontSize="{DynamicResource FontSize.Caption}" Cursor="Hand" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="全部" Command="{Binding SetFilterCommand}" CommandParameter="All" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterKey}" Value="All">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="设置样" Command="{Binding SetFilterCommand}" CommandParameter="SettingUp" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterKey}" Value="SettingUp">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="控制样" Command="{Binding SetFilterCommand}" CommandParameter="Control" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterKey}" Value="Control">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="类型标准化样" Command="{Binding SetFilterCommand}" CommandParameter="TypeStd" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterKey}" Value="TypeStd">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                </StackPanel>
            </DockPanel>

            <!-- SCT 样品台账（真实数据） -->
            <Border Style="{StaticResource Card}" Margin="{DynamicResource Spacing.CardGap}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="SCT 样品台账" Style="{StaticResource Text.CardTitle}" />
                        <TextBlock Text="{Binding DeleteError}" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Brush.Status.Failed}" TextWrapping="Wrap" MaxWidth="600">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding SctSamples}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent"
                              RowStyle="{StaticResource GridRow}" CellStyle="{StaticResource GridCell}"
                              ColumnHeaderStyle="{StaticResource GridColumnHeader}"
                              FontSize="{DynamicResource FontSize.Body}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SampleID" Binding="{Binding SampleId}" FontFamily="Consolas" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="样品名称" Binding="{Binding SampleName}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeDisplay}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="合金" Binding="{Binding AlloyType}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="架位" Binding="{Binding RackPosition}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="关联方法" Binding="{Binding AssociatedMethodText}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="当前/初始厚度 (mm)" Binding="{Binding ThicknessText}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="最小厚度" Binding="{Binding MinThicknessText}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="使用次数" Binding="{Binding UsageText}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTemplateColumn Header="状态">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" Margin="0,2"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Badge.Base}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Normal">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Running.Bg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="NeedMeasure">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Warning.Bg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Warning.Bg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Failed.Bg}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Normal">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Running}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="NeedMeasure">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.Warning.Fg}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.Warning.Fg}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Failed}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="上次使用" Binding="{Binding LastUseText}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="上次测高" Binding="{Binding LastHeightText}" ElementStyle="{StaticResource GridCellText}" />
                            <!-- 删除（弹窗二次确认，行数据保持原样展示） -->
                            <DataGridTemplateColumn Header="操作">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="删除" Cursor="Hand" Padding="10,3" FontSize="{DynamicResource FontSize.Caption}"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="Transparent" Foreground="{DynamicResource Brush.Danger}"
                                                BorderBrush="{DynamicResource Brush.Danger}" BorderThickness="1"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="MinWidth" Value="0" />
                                                    <Setter Property="MinHeight" Value="0" />
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- 分页栏（每页 15 条；翻页组靠右） -->
                    <DockPanel Margin="0,8,0,0" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Text.Caption}">
                            <Run Text="共 " /><Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" 条" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="上一页" Command="{Binding PrevPageCommand}" Padding="10,3"
                                    FontSize="{DynamicResource FontSize.Caption}" Cursor="Hand" />
                            <TextBlock Text="{Binding PageDisplay}" VerticalAlignment="Center" Margin="8,0"
                                       Style="{StaticResource Text.Caption}" />
                            <Button Content="下一页" Command="{Binding NextPageCommand}" Padding="10,3"
                                    FontSize="{DynamicResource FontSize.Caption}" Cursor="Hand" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="使用次数达到上限自动标记「需测高」；厚度低于最小厚度自动「禁用」并报警更换；删除经弹窗二次确认（级联删除标准值与控制限，操作日志保留）" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- 生产样品（真实数据；种子库暂无，显示空态） -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="生产样品（今日）" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8" />
                    <TextBlock Text="暂无生产样品记录（生产样品随分析流程入库）" Style="{StaticResource Text.Caption}"
                               Visibility="{Binding HasProduction, Converter={StaticResource BoolToVisibility.Inverse}}" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding ProductionSamples}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent"
                              Visibility="{Binding HasProduction, Converter={StaticResource BoolToVisibility.Inverse}}"
                              RowStyle="{StaticResource GridRow}" CellStyle="{StaticResource GridCell}"
                              ColumnHeaderStyle="{StaticResource GridColumnHeader}"
                              FontSize="{DynamicResource FontSize.Body}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SampleID" Binding="{Binding SampleId}" FontFamily="Consolas" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="合金" Binding="{Binding AlloyType}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" ElementStyle="{StaticResource GridCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="原始强度与校正后结果双列展示为数据规范硬性要求（随分析流程接入）" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
