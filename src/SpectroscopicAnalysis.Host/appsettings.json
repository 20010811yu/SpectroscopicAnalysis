{
  // 说明：本文件由 Microsoft.Extensions.Configuration 加载，支持 // 行注释与 /* */ 块注释（加载器自动跳过）。
  // 各节属性含义见对应 Options 类中文注释；修改后重启程序生效。

  // 数据库：SQLite 单机库路径（相对程序运行目录）
  "Database": {
    "Path": "Data/spectro.db"
  },

  // EzCad2 激光打标：自动启动的打标软件与工程文件
  "EzCad2": {
    // 打标软件可执行文件路径（留空则不自动启动）
    "ExecutablePath": "",
    // 启动时自动打开的 .ezd 工程文件
    "EzdFilePath": "D:\\Desktop\\261117\\2.ezd",
    // 等待打标软件窗口出现的超时（毫秒）
    "WaitForWindowTimeoutMs": 15000,
    // 是否隐藏打标软件窗口（后台模式）
    "HideWindow": true
  },

  // 激光打标内容：喷码文本源文件与条码模板
  "LaserMarking": {
    // 打标文本内容文件路径
    "ContentFilePath": "D:\\Desktop\\2.txt",
    // 条码打标 .ezd 模板路径
    "BarcodeEzdFilePath": "D:\\Desktop\\261117\\1.ezd"
  },

  // PLC 连接（Modbus TCP；强类型封装见 DeviceInterface/PlcConnectionOptions.cs，非法值启动即快速失败并报错误码 4005）
  "Plc": {
    "Host": "192.168.0.1", // PLC 地址
    "Port": 502, // Modbus TCP 端口
    "ConnectTimeoutMs": 3000, // 建立 TCP 连接超时（毫秒）
    "ReadWriteTimeoutMs": 2000, // 单次读/写寄存器超时（毫秒）
    "RetryCount": 3, // 通信失败重试上限（耗尽走报警链路）
    "ReconnectIntervalMs": 5000 // 连接中断后重连间隔（毫秒）
  },

  // Workflow 编排：超时/重试/轮询集中配置（封装见 Workflow/WorkflowOptions.cs）
  "Workflow": {
    "StepTimeoutMs": 30000, // 单步设备调用超时（毫秒）
    "StepRetryCount": 3, // 设备调用重试上限
    "LockTimeoutMs": 5000, // 锁获取超时（毫秒；失败排队等待）
    "PollIntervalMs": 500, // 主循环轮询间隔（毫秒）
    "TaskDurationMs": 180000, // 单任务执行时长（毫秒；Stub 阶段模拟真实耗时）
    "EngineTickIntervalMs": 60000 // 策略引擎时钟节拍间隔（毫秒）
  },

  // 日志：Serilog 最小级别
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  }
}
